/*
 * conf/base.config -- default per-process resource directives (Phase 9).
 *
 * Deliberately modest: PGX_REPORT runs a single-sample Python CLI call
 * (VCF parse + up to 4 gene calls + up to 5 renderers) that finishes in
 * well under a second against this repo's own test fixtures -- there is no
 * real basis for requesting more than one CPU or a large memory ceiling
 * per sample. Revisit if/when a future phase adds anything genuinely
 * compute-heavy (e.g. an actual variant caller upstream of this pipeline,
 * per docs/PGX_FOUNDATIONS.md's "later extension" note).
 */

process {
    cpus   = 1
    memory = '512.MB'
    time   = '10.m'

    withName: PGX_REPORT {
        cpus   = 1
        memory = '512.MB'
        time   = '5.m'
    }
}
