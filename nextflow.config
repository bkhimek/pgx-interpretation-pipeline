/*
 * nextflow.config -- Phase 9. Kept deliberately small: this pipeline is a
 * thin orchestration layer over one lightweight Python CLI call per
 * sample (see main.nf's header comment), not a heavy bioinformatics
 * workflow with GB-scale processes, so there's no elaborate resource
 * tuning to encode here yet.
 *
 * Only a `standard` (local executor) profile is defined below. A
 * container-based profile (Docker/Singularity/Conda) is a natural future
 * extension -- this repo isn't packaged as a container image, and no such
 * profile was built or tested this phase (this sandbox's network allowlist
 * blocks the Nextflow binary itself, let alone a live container pull and
 * run -- see main.nf's header comment and docs/VALIDATION.md §4 for the
 * same category of documented, honest limitation already established for
 * PharmCAT). Shipping an untested container profile that merely *looks*
 * plausible would be worse than not shipping one -- see this project's own
 * "don't claim untested coverage" discipline (docs/VALIDATION.md,
 * DEVELOPMENT_WORKFLOW.md).
 */

manifest {
    name            = 'pgx-interpretation-pipeline'
    description     = 'Reproducible pharmacogenomics interpretation: VCF -> allele/diplotype -> functional phenotype -> guideline-linked drug recommendation.'
    author          = 'Krzysztof Gizynski'
    homePage        = 'https://github.com/bkhimek/pgx-interpretation-pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.9.0'
}

params {
    input                = null
    outdir               = 'results'
    genome_build         = 'GRCh38'
    genes                = 'TPMT,DPYD,SLCO1B1,CYP2C19'
    formats              = 'json,tsv,html,markdown'
    with_recommendations = true
    evidence_cache_dir   = null
    help                 = false
}

includeConfig 'conf/base.config'

profiles {
    standard {
        process.executor = 'local'
    }
}

// Nextflow's own execution reports (distinct from this pipeline's PGx
// reports, which land under params.outdir instead) -- useful for anyone
// benchmarking or debugging a real run, cheap to always generate.
//
// Deliberately no shared `def timestamp = ...` variable here (an earlier
// version of this file had one): newer Nextflow releases (confirmed
// against 26.04.3) parse nextflow.config with a stricter config DSL that
// rejects a bare top-level variable declaration mixed with config
// statements -- "Variable declarations cannot be mixed with config
// statements". Each block below computes its own timestamp inline instead
// (a few milliseconds apart between the three files, which doesn't matter
// for what these are used for).
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}
